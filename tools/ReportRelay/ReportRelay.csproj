<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The report relay: reports from the plugin in over HTTPS, issues out in the private reports
       repo. Runs as a Windows service on the compute box (docs/REPORTING.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrialHater.ReportRelay</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\TrialHater.Core\TrialHater.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>
</Project>
